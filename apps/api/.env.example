PORT=3000
NODE_ENV=development

# Origin allowed to make cross-origin requests to the API (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Local dev PostgreSQL (see docker command in apps/api/README.md)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_infra?schema=public

# Background pinger: how often to look for monitors due for a check (ms),
# and how long to wait for a monitor's response before treating it as down (ms)
PINGER_TICK_MS=5000
CHECK_TIMEOUT_MS=10000
